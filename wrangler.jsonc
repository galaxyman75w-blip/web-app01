{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app01",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "88233888-f790-4b10-9e8d-1634438aa719","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "ce2c26237c9d4c818895a95e52ae7c9a" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
